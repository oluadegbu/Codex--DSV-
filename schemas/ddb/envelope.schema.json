{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directive.invalid/ddb/v1/envelope.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "const": "SHADOW"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "role": {
      "enum": [
        "supervisor",
        "worker"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "previous": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 1
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "REPORT",
        "DIRECTIVE",
        "COMPLETE",
        "ACK",
        "HEARTBEAT"
      ]
    },
    "body": {
      "type": "object"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "version",
    "mode",
    "id",
    "role",
    "sequence",
    "previous",
    "issued_at",
    "expires_at",
    "policy_sha256",
    "kind",
    "body",
    "content_sha256",
    "signature"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "REPORT"
        },
        "role": {
          "const": "worker"
        },
        "body": {
          "$ref": "report.schema.json"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "DIRECTIVE"
        },
        "role": {
          "const": "supervisor"
        },
        "body": {
          "$ref": "directive.schema.json"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "COMPLETE"
        },
        "role": {
          "const": "supervisor"
        },
        "body": {
          "$ref": "complete.schema.json"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "ACK"
        },
        "role": {
          "const": "worker"
        },
        "body": {
          "$ref": "ack.schema.json"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "HEARTBEAT"
        },
        "role": {
          "const": "worker"
        },
        "body": {
          "$ref": "heartbeat.schema.json"
        }
      }
    }
  ]
}
