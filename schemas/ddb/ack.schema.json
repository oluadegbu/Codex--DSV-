{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directive.invalid/ddb/v1/ack.schema.json",
  "type": "object",
  "properties": {
    "directive_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "directive_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "const": "DURABLY_RECEIVED"
    }
  },
  "required": [
    "directive_id",
    "directive_digest",
    "state"
  ],
  "additionalProperties": false
}
