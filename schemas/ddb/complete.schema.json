{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directive.invalid/ddb/v1/complete.schema.json",
  "type": "object",
  "properties": {
    "directive_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "report_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "const": "ACCEPT_ATTESTED_SHADOW"
    }
  },
  "required": [
    "directive_id",
    "report_digest",
    "verdict"
  ],
  "additionalProperties": false
}
