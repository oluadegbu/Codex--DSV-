{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directive.invalid/ddb/v1/report.schema.json",
  "type": "object",
  "properties": {
    "effort_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "directive_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "IDLE",
        "SUCCEEDED",
        "NEEDS_HUMAN"
      ]
    },
    "evidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "VERIFIED_LOCAL_PAPER"
            },
            "scope_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "result_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "git_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "audit_valid": {
              "const": true
            },
            "exit_code": {
              "const": 0
            }
          },
          "required": [
            "kind",
            "scope_digest",
            "result_digest",
            "artifact_sha256",
            "git_commit",
            "audit_valid",
            "exit_code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "const": "EXECUTION_UNCERTAIN"
            }
          },
          "required": [
            "category"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "effort_id",
    "directive_id",
    "task_id",
    "status",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "IDLE"
          }
        }
      },
      "then": {
        "properties": {
          "directive_id": {
            "type": "null"
          },
          "task_id": {
            "type": "null"
          },
          "evidence": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "directive_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "VERIFIED_LOCAL_PAPER"
              },
              "scope_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "result_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "git_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "audit_valid": {
                "const": true
              },
              "exit_code": {
                "const": 0
              }
            },
            "required": [
              "kind",
              "scope_digest",
              "result_digest",
              "artifact_sha256",
              "git_commit",
              "audit_valid",
              "exit_code"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NEEDS_HUMAN"
          }
        }
      },
      "then": {
        "properties": {
          "directive_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "category": {
                "const": "EXECUTION_UNCERTAIN"
              }
            },
            "required": [
              "category"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
