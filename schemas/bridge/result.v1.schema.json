{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dci:bhb:result:v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "RESULT"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "sender": {
      "type": "string"
    },
    "recipient": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "evidence": {
          "type": "object"
        }
      },
      "required": [
        "state",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "kind",
    "message_id",
    "task_id",
    "correlation_id",
    "sender",
    "recipient",
    "sequence",
    "issued_at",
    "expires_at",
    "payload"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "sender": {
          "const": "hands"
        },
        "recipient": {
          "const": "runner"
        }
      }
    },
    {
      "properties": {
        "sender": {
          "const": "runner"
        },
        "recipient": {
          "const": "brain"
        }
      }
    }
  ],
  "description": "Transport contract only. Runtime enforces sender authentication, route-specific payloads, expiry, sequence and lifecycle. Local shadow deployment only."
}
